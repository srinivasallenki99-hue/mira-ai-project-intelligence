{
  "name": "Mira_12_ReviewDispatcher",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "\n\n{\n  \"run_id\": \"\",\n  \"snapshot_id\": \"\",\n  \"project_name\": \"\",\n  \"document_version\": \"1.0\",\n  \"reviewer_email\": \"\",\n  \"file_type\": \"pdf\",\n  \"file_id\": \"\",\n  \"file_url\": \"\",\n  \"request_id\": \"\",\n  \"review_type\": \"document\",\n  \"capability\": \"\",\n  \"requested_capabilities\": [],\n  \"report_title\": \"\",\n  \"report_content\": \"\",\n  \"draft_only\": true\n}\n"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "bf8ceb12-3795-4787-b403-95ef25aeace2",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst clean = v => String(v ?? '').trim();\n\nconst reviewType = clean(\n  r.review_type || 'document'\n).toLowerCase();\n\nif (!['document', 'report'].includes(reviewType)) {\n  throw new Error('Invalid review_type');\n}\n\nconst required = [\n  'run_id',\n  'snapshot_id',\n  'project_name',\n  'reviewer_email'\n];\n\nif (reviewType === 'document') {\n  required.push(\n    'document_version',\n    'file_type',\n    'file_id',\n    'file_url'\n  );\n} else {\n  required.push('report_content');\n}\n\nfor (const field of required) {\n  if (!clean(r[field])) {\n    throw new Error(`Missing ${field}`);\n  }\n}\n\nconst reviewer = clean(r.reviewer_email).toLowerCase();\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(reviewer)) {\n  throw new Error('Invalid reviewer_email');\n}\n\nlet fileType = '';\nlet fileUrl = '';\n\nif (reviewType === 'document') {\n  fileType = clean(r.file_type).toLowerCase();\n\n  if (!['docx', 'pdf', 'pptx'].includes(fileType)) {\n    throw new Error('Invalid file_type');\n  }\n\n  fileUrl = clean(r.file_url);\n\n  if (!/^https:\\/\\/(drive|docs)\\.google\\.com\\//i.test(fileUrl)) {\n    throw new Error('Expected a Google Drive document URL');\n  }\n}\n\nreturn [{\n  json: {\n    ...r,\n    run_id: clean(r.run_id),\n    snapshot_id: clean(r.snapshot_id),\n    project_name: clean(r.project_name),\n    reviewer_email: reviewer,\n    review_type: reviewType,\n    document_version:\n      clean(r.document_version) || '1.0',\n    file_type: fileType,\n    file_id: clean(r.file_id),\n    file_url: fileUrl,\n    report_content:\n      reviewType === 'report'\n        ? clean(r.report_content)\n        : '',\n    review_id: 'REV-' + $execution.id,\n    status: 'pending_review',\n    requested_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "3470f47c-0ff0-4ea7-8d4f-612b80a057ec",
      "name": "Validate Review Request"
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('Validate Review Request').first().json.reviewer_email }}",
        "subject": "={{ 'MIRA Approval Required - ' + $('Validate Review Request').first().json.project_name + ' - v' + $('Validate Review Request').first().json.document_version }}\n",
        "message": "={{ (() => {\n  const r = $('Validate Review Request').first().json;\n\n  const esc = v => String(v ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n\n  const isReport = r.review_type === 'report';\n\n  const reviewContent = isReport\n    ? `\n      <h3>Draft Report for Review</h3>\n      <div style=\"\n        white-space:pre-wrap;\n        font-family:Arial,sans-serif;\n        font-size:13px;\n        line-height:1.5;\n        text-align:left;\n        border:1px solid #ddd;\n        padding:16px;\n      \">${esc(r.report_content)}</div>\n    `\n    : `\n      <h3>Document for Review</h3>\n      <p>\n        <strong>Format:</strong> ${esc(r.file_type)}\n      </p>\n      <p>\n        <a href=\"${esc(r.file_url)}\">\n          View project document\n        </a>\n      </p>\n    `;\n\n  return `\n    <div style=\"\n      font-family:Arial,sans-serif;\n      max-width:750px;\n      margin:auto;\n      line-height:1.6;\n      color:#222;\n    \">\n\n      <h2>MIRA — Review & Approval Required</h2>\n\n      <p>Hello,</p>\n\n      <p>\n        A new MIRA project intelligence output\n        is ready for your review.\n      </p>\n\n      <p><strong>Project:</strong>\n        ${esc(r.project_name)}</p>\n\n      <p><strong>Run ID:</strong>\n        ${esc(r.run_id)}</p>\n\n      <p><strong>Review ID:</strong>\n        ${esc(r.review_id)}</p>\n\n      <p><strong>Capability:</strong>\n        ${esc(r.capability || 'Not specified')}</p>\n\n      <p><strong>Review Type:</strong>\n        ${esc(r.review_type)}</p>\n\n      <p><strong>Version:</strong>\n        ${esc(r.document_version)}</p>\n\n      <p><strong>Status:</strong>\n        Pending Review</p>\n\n      <hr>\n\n      ${reviewContent}\n\n      <hr>\n\n      <p>\n        Please review the content above before\n        selecting Approve or Decline using the\n        approval buttons below.\n      </p>\n\n      <p>\n        Approval applies only to this specific\n        review request and report version.\n      </p>\n\n      <p>\n        This is a DRAFT generated by MIRA.\n        Approval does not automatically authorize\n        external distribution.\n      </p>\n\n      <p>\n        Thank you,<br>\n        MIRA Project Intelligence Assistant\n      </p>\n\n    </div>\n  `;\n})() }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        704,
        0
      ],
