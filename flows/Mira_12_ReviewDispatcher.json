    {
      "parameters": {
        "jsCode": "const r = $('Validate Review Request').first().json;\n\nif (r.review_type !== 'report') {\n  throw new Error(\n    'PDF content preparation supports report reviews only'\n  );\n}\n\nif (!r.report_content?.trim()) {\n  throw new Error('Approved report content is missing');\n}\n\n// Use the exact report submitted for approval.\n// Normalize Markdown display characters only.\nconst formattedBody = String(r.report_content)\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/^#{1,6}\\s+(.+)$/gm, (_, title) =>\n    '\\n' + title.toUpperCase() + '\\n'\n  )\n  .replace(/\\*\\*(.*?)\\*\\*/g, '$1')\n  .replace(/<details>/g, '')\n  .replace(/<\\/details>/g, '')\n  .replace(/<summary>(.*?)<\\/summary>/g, '$1')\n  .trim();\n\nreturn [{\n  json: {\n    review_id: r.review_id,\n    run_id: r.run_id,\n    project_name: r.project_name,\n    capability: r.capability || 'multi',\n    reviewer_email: r.reviewer_email,\n    document_name:\n      `MIRA_${r.capability || 'report'}_${r.run_id}_APPROVED`,\n    formatted_body: formattedBody,\n    original_report_content: r.report_content,\n    approval_status: 'APPROVED'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        272
      ],
      "id": "1b6dd40f-fa6a-40f3-a570-d765239c0055",
      "name": "Prepare PDF Content"
    },
    {
