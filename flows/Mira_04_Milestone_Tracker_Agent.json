    {
      "parameters": {
        "description": "\nRetrieve read-only, approved project data for Mira's Milestone Tracker AI Agent.\n\nUse project_timeline.csv as the authoritative source for project phases, relative week ranges, and milestone deliverables.\n\nUse sample_task_board.csv as the authoritative source for task statuses, due dates, assignees, and documented blockers.\n\nAlways retrieve data using the requested snapshot_id. Never mix snapshots.\n\nDo not invent milestone completion dates, project start dates, dependencies, or schedule delays.\n\nReturn source-grounded evidence for milestone tracking, blocked-task identification, schedule-risk analysis, and missing-date reporting.\n",
        "workflowId": {
          "__rl": true,
          "value": "REMAP_WORKFLOW_ID",
          "mode": "list",
          "cachedResultName": "MIRA_Get_Project_Data"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
