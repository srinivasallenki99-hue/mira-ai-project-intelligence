    {
      "parameters": {
        "jsCode": "\nconst trig = $('When Orchestrator Requests Milestones').first().json;\nconst trace = $('Capture Trace Context').first().json;\nconst item = $input.first()?.json || {};\n\nif (item.error) {\n  throw new Error(String(item.error.message || item.error));\n}\n\nlet result = item.output ?? item.text ?? item;\n\nif (typeof result === 'string') {\n  const clean = result.trim()\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/```\\s*$/, '');\n\n  try {\n    result = JSON.parse(clean);\n  } catch (e) {\n    throw new Error('Milestone Agent returned invalid JSON.');\n  }\n}\n\nif (result?.output && typeof result.output === 'object') {\n  result = result.output;\n}\n\nif (!result || Array.isArray(result) ||\n    !Array.isArray(result.phases) ||\n    !Array.isArray(result.milestones) ||\n    !Array.isArray(result.blocked_tasks) ||\n    !Array.isArray(result.milestone_alerts)) {\n  throw new Error('Invalid Milestone Agent output schema.');\n}\n\nfor (const phase of result.phases) {\n  if (!Number.isInteger(phase.start_week) ||\n      !Number.isInteger(phase.end_week) ||\n      phase.start_week < 1 ||\n      phase.end_week < phase.start_week) {\n    throw new Error(\n      'Invalid week range for phase: ' + phase.phase_name\n    );\n  }\n}\n\nfor (const milestone of result.milestones) {\n  if (!milestone.name || !milestone.source_reference) {\n    throw new Error('Milestone name or source reference missing.');\n  }\n}\n\nfor (const task of result.blocked_tasks) {\n  if (!task.task_id ||\n      String(task.status).trim().toLowerCase() !== 'blocked' ||\n      !task.source_reference) {\n    throw new Error('Invalid blocked-task record.');\n  }\n}\n\nreturn [{\n  json: {\n    ...result,\n    agent: 'milestone',\n    snapshot_id: trig.snapshot_id || '',\n    generated_at: new Date().toISOString(),\n    status: 'ok',\n    phase_count: result.phases.length,\n    milestone_count: result.milestones.length,\n    blocked_count: result.blocked_tasks.length,\n    validation_status: 'PARTIAL',\n    trace_id: trig.trace_id || trace.trace_id || '',\n    span_id: trace.span_id || ''\n  }\n}];\n"
      },
