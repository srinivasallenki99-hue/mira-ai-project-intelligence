    {
      "parameters": {
        "jsCode": "const hex = n => { let s = ''; for (let i = 0; i < n; i++) { s += Math.floor(Math.random() * 16).toString(16); } return s; };\nconst hexRe32 = /^[0-9a-f]{32}$/i;\nconst hexRe16 = /^[0-9a-f]{16}$/i;\nreturn $input.all().map(item => {\n  const j = item.json;\n  const traceId = hexRe32.test(String(j.trace_id || '')) ? String(j.trace_id).toLowerCase() : hex(32);\n  const parentId = hexRe16.test(String(j.parent_span_id || '')) ? String(j.parent_span_id).toLowerCase() : '';\n  return { json: Object.assign({}, j, { trace_id: traceId, parent_span_id: parentId, span_id: hex(16), test_case_id: j.test_case_id || '', start_time_ns: String(Date.now()) + '000000' }) };\n});"
      },
