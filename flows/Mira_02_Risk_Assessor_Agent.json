      "parameters": {
        "jsCode": "\nconst trig = $('When Orchestrator Requests Risks').first().json;\nconst trace = $('Capture Trace Context').first().json;\nconst item = $input.first()?.json || {};\n\nif (item.error) {\n  throw new Error(String(item.error.message || item.error));\n}\n\nlet result = item.output ?? item.text ?? item;\n\nif (typeof result === 'string') {\n  const clean = result.trim()\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/```\\s*$/, '');\n\n  try {\n    result = JSON.parse(clean);\n  } catch (e) {\n    throw new Error('Risk Agent returned invalid JSON.');\n  }\n}\n\nif (result?.output && typeof result.output === 'object') {\n  result = result.output;\n}\n\nif (!result || Array.isArray(result) ||\n    !Array.isArray(result.risks) ||\n    !Array.isArray(result.top_risk_ids)) {\n  throw new Error('Invalid Risk Agent output schema.');\n}\n\nconst ids = result.risks.map(r => String(r.risk_id || '').trim());\n\nif (ids.some(id => !id) || new Set(ids).size !== ids.length) {\n  throw new Error('Missing or duplicate risk IDs.');\n}\n\nconst invalidTopIds = result.top_risk_ids.filter(\n  id => !ids.includes(String(id))\n);\n\nif (invalidTopIds.length) {\n  throw new Error(\n    'Top risk IDs are absent from the reported risks: ' +\n    invalidTopIds.join(', ')\n  );\n}\n\nfor (const risk of result.risks) {\n  if (!risk.source_reference) {\n    throw new Error(\n      'Risk ' + risk.risk_id + ' has no source reference.'\n    );\n  }\n}\n\nreturn [{\n  json: {\n    ...result,\n    agent: 'risk',\n    snapshot_id: trig.snapshot_id || '',\n    generated_at: new Date().toISOString(),\n    status: 'ok',\n    risk_count: result.risks.length,\n    validation_status: 'PARTIAL',\n    trace_id: trig.trace_id || trace.trace_id || '',\n    span_id: trace.span_id || ''\n  }\n}];\n\n"
      },
